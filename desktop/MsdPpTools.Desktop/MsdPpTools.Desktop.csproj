<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Output exe / Windows Explorer "Details" metadata only — the C# namespace, project
         folder, and .csproj/.slnx file names deliberately stay MsdPpTools(.Desktop) to avoid
         a much larger, riskier rename across every path reference. -->
    <AssemblyName>PowerAppsStudioTools</AssemblyName>
    <Product>Power Apps Studio &amp; Tools</Product>
    <AssemblyTitle>Power Apps Studio &amp; Tools</AssemblyTitle>
    <Description>Open-source desktop toolbox for Power Apps / Dataverse / Dynamics 365 admins and developers.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Identity.Client" Version="4.87.0" />
    <PackageReference Include="Microsoft.Identity.Client.Extensions.Msal" Version="4.87.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="10.0.0" />
    <!-- Not compiled/linked against — restored purely so Microsoft.Xrm.Sdk.dll (needed to
         resolve the IPlugin interface inside MetadataLoadContext) is on disk at build time.
         See Plugins/PluginAssemblyInspector.cs. -->
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" Version="9.0.2.60" ExcludeAssets="all" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(PkgMicrosoft_CrmSdk_CoreAssemblies)\lib\net462\Microsoft.Xrm.Sdk.dll"
          CopyToOutputDirectory="PreserveNewest"
          Link="ReferenceAssemblies\Microsoft.Xrm.Sdk.dll" />
  </ItemGroup>

</Project>
